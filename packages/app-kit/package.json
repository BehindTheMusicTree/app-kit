{
  "name": "@behindthemusictree/app-kit",
  "version": "17.1.0",
  "description": "Headless transport, auth, popup state, player, and genre-tree data plumbing for BehindTheMusicTree React apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/BehindTheMusicTree/app-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js",
      "require": "./dist/transport/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./popup": {
      "types": "./dist/popup/index.d.ts",
      "import": "./dist/popup/index.js",
      "require": "./dist/popup/index.cjs"
    },
    "./track-noun": {
      "types": "./dist/track-noun/index.d.ts",
      "import": "./dist/track-noun/index.js",
      "require": "./dist/track-noun/index.cjs"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js",
      "require": "./dist/player/index.cjs"
    },
    "./genre-tree": {
      "types": "./dist/genre-tree/index.d.ts",
      "import": "./dist/genre-tree/index.js",
      "require": "./dist/genre-tree/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "tsc --noEmit && node scripts/check-headless.mjs",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "uuid": "11.1.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.72.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@types/youtube": "^0.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "next": "^15.5.27",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "author": "Andreas Garcia",
  "license": "ISC"
}
