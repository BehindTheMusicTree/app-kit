{
  "name": "@behindthemusictree/app-kit",
  "version": "0.1.0",
  "description": "Shared transport, auth, popup, UI, player, and genre-tree plumbing for BehindTheMusicTree React apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/BehindTheMusicTree/app-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js",
      "require": "./dist/transport/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./popup": {
      "types": "./dist/popup/index.d.ts",
      "import": "./dist/popup/index.js",
      "require": "./dist/popup/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js",
      "require": "./dist/player/index.cjs"
    },
    "./genre-tree": {
      "types": "./dist/genre-tree/index.d.ts",
      "import": "./dist/genre-tree/index.js",
      "require": "./dist/genre-tree/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "next": ">=14.0.0"
  },
  "dependencies": {
    "@behindthemusictree/genre-tree-view": "0.1.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.2.0",
    "uuid": "10.0.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.72.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "next": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "author": "Andreas Garcia",
  "license": "ISC"
}
